# Copy this file to .env and fill in the values

# MongoDB connection string from MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ruet-attendance

# Secret key for signing JWT tokens (use a long random string)
JWT_SECRET=your_super_secret_jwt_key_here

# URL of the deployed frontend (used for CORS)
CLIENT_URL=https://your-app.vercel.app

# Server port (Render sets this automatically)
PORT=5000

# Environment
NODE_ENV=production
